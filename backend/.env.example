# ── Сервер ────────────────────────────────────────────────────────────────
# Порт, на котором слушает backend
PORT=3001
# Origin фронтенда, разрешённый для CORS (в dev Vite отдаёт 5173)
FRONTEND_ORIGIN=http://localhost:5173
# Публичный адрес админки — подставляется в кнопку под сообщением в Telegram
PUBLIC_ADMIN_URL=http://localhost:5173/superadmin

# ── LLM: Google Gemini ────────────────────────────────────────────────────
# Ключ Gemini API. Если задан — Gemini используется как основной провайдер.
GEMINI_API_KEY=
# Цепочка моделей Gemini через запятую. Порядок = приоритет.
# При 429 / перегрузе / таймауте backend мгновенно берёт следующую — юзер ничего не замечает.
# Берём быстрые нерассуждающие модели: для ответов по услугам reasoning не нужен.
GEMINI_MODELS=gemini-3.1-flash-lite,gemini-3.5-flash-lite,gemini-3.6-flash

# ── LLM: Anthropic Claude ─────────────────────────────────────────────────
# Ключ Anthropic API. Используется, если Gemini недоступен или ключ не задан.
ANTHROPIC_API_KEY=
# Цепочка моделей Claude через запятую. Haiku — самая быстрая, Sonnet — запасная.
ANTHROPIC_MODELS=claude-haiku-4-5,claude-sonnet-5

# ── LLM: общие настройки ──────────────────────────────────────────────────
# Явный выбор провайдера: gemini | anthropic | mock.
# Переопределяет автоопределение по наличию ключей. Обычно оставить пустым.
LLM_PROVIDER=
# Принудительный mock-режим (сценарные ответы без обращения к LLM)
USE_MOCK_LLM=false
# Жёсткий таймаут одного запроса к модели, мс. Истёк — сразу пробуем следующую модель.
LLM_TIMEOUT_MS=8000

# ── Telegram ──────────────────────────────────────────────────────────────
# Токен бота от @BotFather
TELEGRAM_BOT_TOKEN=
# Куда слать заявки. Можно несколько чатов через запятую — например рабочая
# группа и личка руководителя: TELEGRAM_CHAT_ID=-1001234567890,123456789
# ID группы отрицательный, ID личного чата положительный.
# Как получить: добавить бота в группу, написать туда любое сообщение, открыть
# https://api.telegram.org/bot<ТОКЕН>/getUpdates и взять result[].message.chat.id
# Внимание: при повышении группы до супергруппы её ID меняется — возьмите новый.
TELEGRAM_CHAT_ID=
# Long polling для кнопки «Взять в работу» под заявкой. Включать только на одном инстансе.
TELEGRAM_ENABLE_POLLING=false

# ── Админка /superadmin ───────────────────────────────────────────────────
# Пароль входа. ОБЯЗАТЕЛЬНО поменять перед публикацией.
ADMIN_PASSWORD=change-me-please
# Секрет для подписи токена сессии. Любая длинная случайная строка.
ADMIN_SECRET=replace-with-long-random-string
